{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/nexus.object_state@1",
  "title": "NexusObject lifecycle projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "object_id", "lifecycle", "validity", "payload_state"],
  "properties": {
    "schema_id": {"const": "nexus.object_state"},
    "schema_version": {"const": 1},
    "object_id": {"type": "string", "minLength": 1},
    "revision": {"enum": ["CURRENT", "SUPERSEDED"]},
    "lifecycle": {"enum": ["ACTIVE", "RETIRED"]},
    "validity": {"enum": ["VALID", "INVALIDATED"]},
    "payload_state": {"enum": ["AVAILABLE", "ARCHIVED", "PURGED"]}
  }
}
