{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/nexus.purge_barrier@1",
  "title": "Nexus PurgeBarrier v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "barrier_id", "plan_id", "protected_refs", "lineage_revision", "status", "active_run_refs", "created_at"],
  "properties": {
    "schema_id": {"const": "nexus.purge_barrier"},
    "schema_version": {"const": 1},
    "barrier_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "protected_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "lineage_revision": {"type": "integer", "minimum": 0},
    "status": {"enum": ["ACTIVE", "PARTIAL", "RELEASED"]},
    "active_run_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
