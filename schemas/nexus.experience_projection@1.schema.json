{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/nexus.experience_projection@1",
  "title": "Nexus deterministic ExperienceProjection v1 (non-persisted)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "projection_kind", "projection_status", "identity", "lifecycle",
    "subtasks_and_attempts", "trace_summary", "verification", "effects", "approvals", "budget", "metering",
    "routing_and_capabilities", "skill_resolution", "context", "memory_participation", "continuation",
    "failure_signals", "governance_coverage", "human_signals", "unknowns", "source_refs", "provenance"
  ],
  "properties": {
    "schema_id": {"const": "nexus.experience_projection"},
    "schema_version": {"const": 1},
    "projection_kind": {"const": "DETERMINISTIC_READ_MODEL"},
    "projection_status": {"const": "AVAILABLE"},
    "identity": {"$ref": "#/$defs/identity"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "subtasks_and_attempts": {"$ref": "#/$defs/subtasksAndAttempts"},
    "trace_summary": {"$ref": "#/$defs/traceSummary"},
    "verification": {"$ref": "#/$defs/verification"},
    "effects": {"$ref": "#/$defs/effects"},
    "approvals": {"$ref": "#/$defs/approvals"},
    "budget": {"$ref": "#/$defs/budget"},
    "metering": {"$ref": "#/$defs/metering"},
    "routing_and_capabilities": {"$ref": "#/$defs/routingAndCapabilities"},
    "skill_resolution": {"$ref": "#/$defs/skillResolution"},
    "context": {"$ref": "#/$defs/context"},
    "memory_participation": {"$ref": "#/$defs/memoryParticipation"},
    "continuation": {"$ref": "#/$defs/continuation"},
    "failure_signals": {"$ref": "#/$defs/boundedFailureSignals"},
    "governance_coverage": {"$ref": "#/$defs/governanceCoverage"},
    "human_signals": {"$ref": "#/$defs/humanSignals"},
    "unknowns": {"$ref": "#/$defs/unknowns"},
    "source_refs": {"$ref": "#/$defs/sourceRefs"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "ref": {"type": "string", "minLength": 1, "maxLength": 128},
    "nullableRef": {"type": ["string", "null"], "maxLength": 128},
    "timestamp": {"type": "string", "minLength": 1, "format": "date-time"},
    "count": {"type": "integer", "minimum": 0},
    "countMap": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "additionalProperties": {"$ref": "#/$defs/count"}},
    "boundedRefs": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "total_count", "truncated"],
      "properties": {
        "items": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "total_count": {"$ref": "#/$defs/count"}, "truncated": {"type": "boolean"}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "requester_id", "root_run_id", "created_at"],
      "properties": {
        "task_id": {"$ref": "#/$defs/ref"}, "requester_id": {"$ref": "#/$defs/ref"},
        "root_run_id": {"$ref": "#/$defs/ref"}, "created_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "parent_run_id", "subtask_id", "executor_kind", "status", "grant_id", "grant_status", "created_at"],
      "properties": {
        "run_id": {"$ref": "#/$defs/ref"}, "parent_run_id": {"$ref": "#/$defs/nullableRef"},
        "subtask_id": {"$ref": "#/$defs/nullableRef"}, "executor_kind": {"enum": ["ORCHESTRATOR", "MODEL", "TOOL"]},
        "status": {"enum": ["CREATED", "READY", "RUNNING", "WAITING", "VERIFYING", "SUCCEEDED", "FAILED", "CANCELLED"]},
        "grant_id": {"$ref": "#/$defs/ref"}, "grant_status": {"enum": ["PROPOSED", "ACTIVE", "EXPIRED", "REVOKED"]},
        "created_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["task_status", "root_run_status", "task_created_at", "runs", "outcome_interpretation", "semantic_quality"],
      "properties": {
        "task_status": {"enum": ["CREATED", "ACTIVE", "WAITING", "SUCCEEDED", "FAILED", "CANCELLED"]},
        "root_run_status": {"enum": ["CREATED", "READY", "RUNNING", "WAITING", "VERIFYING", "SUCCEEDED", "FAILED", "CANCELLED"]},
        "task_created_at": {"$ref": "#/$defs/timestamp"},
        "runs": {"type": "object", "additionalProperties": false, "required": ["items", "total_count", "truncated"],
          "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/run"}}, "total_count": {"$ref": "#/$defs/count"}, "truncated": {"type": "boolean"}}},
        "outcome_interpretation": {"const": "LIFECYCLE_ONLY"}, "semantic_quality": {"const": "UNKNOWN"}
      }
    },
    "subtask": {
      "type": "object", "additionalProperties": false,
      "required": ["subtask_id", "node_index", "status", "final_attempt_id", "final_outcome", "finalized_at", "attempt_count", "created_at"],
      "properties": {
        "subtask_id": {"$ref": "#/$defs/ref"}, "node_index": {"type": "integer", "minimum": 0},
        "status": {"enum": ["PENDING", "READY", "RUNNING", "WAITING", "SUCCEEDED", "FAILED", "CANCELLED", "STALE"]},
        "final_attempt_id": {"$ref": "#/$defs/nullableRef"},
        "final_outcome": {"enum": ["SUCCEEDED", "FAILED", "CANCELLED", "POLICY_DENIED", "BUDGET_DENIED", "INCONCLUSIVE", null]},
        "finalized_at": {"$ref": "#/$defs/nullableTimestamp"}, "attempt_count": {"$ref": "#/$defs/count"},
        "created_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "nullableTimestamp": {"type": ["string", "null"], "format": "date-time"},
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "subtask_id", "attempt_no", "run_id", "requested_capability", "attempt_reason", "predecessor_attempt_id", "outcome", "created_at"],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/ref"}, "subtask_id": {"$ref": "#/$defs/ref"},
        "attempt_no": {"type": "integer", "minimum": 1}, "run_id": {"$ref": "#/$defs/ref"},
        "requested_capability": {"$ref": "#/$defs/ref"},
        "attempt_reason": {"enum": ["INITIAL", "RETRY", "UNSPECIFIED", "CODEX_HOST_DECLARED", "CODEX_HOST_TOOL_DECLARED", "LEGACY_SINGLE_RUN", "LEGACY_SINGLE_RUN_BACKFILL", "VERIFIER_REQUIRED_ESCALATION", "POLICY_DENIED", "BUDGET_DENIED", "AUTHORIZATION_DENIED", "DAILY_TASK_RESOURCE_SCOPE_INVALID", "DAILY_TASK_LOGICAL_ID_CONFLICT", "CONTINUATION_PLAN_INVALID", "CONTINUATION_STATE_CONFLICT", "UNKNOWN"]},
        "predecessor_attempt_id": {"$ref": "#/$defs/nullableRef"},
        "outcome": {"enum": ["CREATED", "READY", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED", "POLICY_DENIED", "BUDGET_DENIED", "INCONCLUSIVE"]},
        "created_at": {"$ref": "#/$defs/timestamp"}, "route_decision": {"$ref": "#/$defs/nullableRef"}
      }
    },
    "routeV1": {
      "type": "object", "additionalProperties": false,
      "required": ["route_decision_id", "schema_version", "subtask_id", "task_class", "risk_class", "quality_requirement", "selected_model_class", "reason_codes", "created_at", "availability"],
      "properties": {
        "route_decision_id": {"$ref": "#/$defs/ref"}, "schema_version": {"const": 1}, "subtask_id": {"$ref": "#/$defs/ref"},
        "task_class": {"$ref": "#/$defs/ref"}, "risk_class": {"enum": ["LOW", "STANDARD", "HIGH", "CRITICAL"]}, "quality_requirement": {"enum": ["ROUTINE", "STANDARD", "CRITICAL"]},
        "selected_model_class": {"enum": ["E0", "E1", "E2", "specialist", "local_private"]}, "reason_codes": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/ref"}},
        "created_at": {"$ref": "#/$defs/timestamp"}, "availability": {"const": "AVAILABLE"}
      }
    },
    "routeV2": {
      "type": "object", "additionalProperties": false,
      "required": ["route_decision_id", "schema_version", "subtask_id", "attempt_no", "requested_capability", "actual_executor_kind", "execution_source", "model_identity_status", "reason_codes", "created_at", "availability"],
      "properties": {
        "route_decision_id": {"$ref": "#/$defs/ref"}, "schema_version": {"const": 2}, "subtask_id": {"$ref": "#/$defs/ref"},
        "attempt_no": {"type": "integer", "minimum": 1}, "requested_capability": {"enum": ["TOOL", "E0", "E1", "E2", "UNSPECIFIED"]},
        "actual_executor_kind": {"enum": ["MODEL", "TOOL"]}, "execution_source": {"enum": ["CODEX_HOST_DECLARED", "CODEX_HOST_TOOL_DECLARED", "DETERMINISTIC_RUNTIME"]},
        "model_identity_status": {"enum": ["OBSERVED", "UNAVAILABLE", "NOT_APPLICABLE"]}, "reason_codes": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/ref"}},
        "created_at": {"$ref": "#/$defs/timestamp"}, "availability": {"const": "AVAILABLE"}
      }
    },
    "redactedRoute": {
      "type": "object", "additionalProperties": false, "required": ["route_decision_id", "availability"],
      "properties": {"route_decision_id": {"enum": ["REDACTED", "REDACTED_PURGED"]}, "availability": {"enum": ["REDACTED", "REDACTED_PURGED"]}}
    },
    "boundedRoutes": {
      "type": "object", "additionalProperties": false, "required": ["status", "items", "total_count", "truncated"],
      "properties": {
        "status": {"enum": ["AVAILABLE", "NONE_RECORDED"]},
        "items": {"type": "array", "maxItems": 100, "items": {"oneOf": [{"$ref": "#/$defs/routeV1"}, {"$ref": "#/$defs/routeV2"}]}},
        "total_count": {"$ref": "#/$defs/count"}, "truncated": {"type": "boolean"}
      }
    },
    "redactedRoutes": {
      "type": "object", "additionalProperties": false, "required": ["status", "items", "total_count", "truncated"],
      "properties": {"status": {"const": "REDACTED"}, "items": {"type": "array", "maxItems": 0}, "total_count": {"type": "null"}, "truncated": {"const": false}}
    },
    "subtasksAndAttempts": {
      "type": "object", "additionalProperties": false, "required": ["subtasks", "attempts", "routing"],
      "properties": {
        "subtasks": {"type": "object", "additionalProperties": false, "required": ["items", "total_count", "truncated"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/subtask"}}, "total_count": {"$ref": "#/$defs/count"}, "truncated": {"type": "boolean"}}},
        "attempts": {"type": "object", "additionalProperties": false, "required": ["items", "total_count", "truncated"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/attempt"}}, "total_count": {"$ref": "#/$defs/count"}, "truncated": {"type": "boolean"}}},
        "routing": {"oneOf": [{"$ref": "#/$defs/boundedRoutes"}, {"$ref": "#/$defs/redactedRoutes"}]}
      }
    },
    "traceItem": {
      "type": "object", "additionalProperties": false, "required": ["event_id", "run_id", "seq_no", "event_type", "occurred_at"],
      "properties": {"event_id": {"$ref": "#/$defs/ref"}, "run_id": {"$ref": "#/$defs/ref"}, "seq_no": {"$ref": "#/$defs/count"}, "event_type": {"$ref": "#/$defs/ref"}, "occurred_at": {"$ref": "#/$defs/timestamp"}}
    },
    "traceSummary": {
      "type": "object", "additionalProperties": false, "required": ["status", "event_count", "counts_by_event_type", "items", "truncated", "event_types_truncated"],
      "properties": {
        "status": {"enum": ["AVAILABLE", "NONE_RECORDED", "REDACTED"]}, "event_count": {"type": ["integer", "null"], "minimum": 0},
        "counts_by_event_type": {"$ref": "#/$defs/countMap"}, "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/traceItem"}},
        "truncated": {"type": "boolean"}, "event_types_truncated": {"type": "boolean"}
      }
    },
    "verificationItem": {
      "type": "object", "additionalProperties": false,
      "required": ["verification_id", "run_id", "target_ref", "target_scope", "verdict", "verifier_kind", "attester_principal_id", "approval_ref", "created_at", "evidence_ref_count", "missing_evidence_count", "conflict_count"],
      "properties": {
        "verification_id": {"$ref": "#/$defs/ref"}, "run_id": {"$ref": "#/$defs/ref"}, "target_ref": {"$ref": "#/$defs/ref"},
        "target_scope": {"const": "TARGET_SPECIFIC"}, "verdict": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
        "verifier_kind": {"enum": ["T1_DETERMINISTIC", "T2_AUTHORITATIVE", "T3_HUMAN_OR_DOMAIN", "T4_EVIDENCE_CONSTRAINED_MODEL", "T5_SELF_CHECK"]},
        "attester_principal_id": {"$ref": "#/$defs/nullableRef"}, "approval_ref": {"$ref": "#/$defs/nullableRef"},
        "created_at": {"$ref": "#/$defs/timestamp"}, "evidence_ref_count": {"$ref": "#/$defs/count"},
        "missing_evidence_count": {"$ref": "#/$defs/count"}, "conflict_count": {"$ref": "#/$defs/count"}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false, "required": ["status", "items", "total_count", "truncated", "verifier_kind_counts", "whole_task_verification", "semantic_quality"],
      "properties": {
        "status": {"enum": ["AVAILABLE", "NONE_RECORDED", "REDACTED"]}, "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/verificationItem"}},
        "total_count": {"type": ["integer", "null"], "minimum": 0}, "truncated": {"type": "boolean"},
        "verifier_kind_counts": {"oneOf": [{"$ref": "#/$defs/countMap"}, {"type": "null"}]},
        "whole_task_verification": {"enum": ["UNKNOWN", "NONE"]}, "semantic_quality": {"const": "UNKNOWN"}
      }
    },
    "effectItem": {
      "type": "object", "additionalProperties": false, "required": ["effect_id", "run_id", "tool_id", "action_type", "execution_state", "effect_outcome", "reconciliation_status", "approval_ref", "created_at", "updated_at"],
      "properties": {
        "effect_id": {"$ref": "#/$defs/ref"}, "run_id": {"$ref": "#/$defs/ref"}, "tool_id": {"$ref": "#/$defs/ref"}, "action_type": {"$ref": "#/$defs/ref"},
        "execution_state": {"enum": ["DECLARED", "PREPARED", "AUTHORIZED", "COMMITTING", "FINISHED", "CANCELLED"]},
        "effect_outcome": {"enum": ["UNDETERMINED", "COMMITTED", "NOT_COMMITTED", "UNKNOWN"]},
        "reconciliation_status": {"enum": ["NOT_REQUIRED", "PENDING", "RETRYING", "EXHAUSTED", "HUMAN_REQUIRED", "BLOCK_AND_ALERT", "RESOLVED"]},
        "approval_ref": {"$ref": "#/$defs/nullableRef"}, "created_at": {"$ref": "#/$defs/timestamp"}, "updated_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "effects": {
      "type": "object", "additionalProperties": false, "required": ["status", "items", "total_count", "truncated", "counts_by_outcome"],
      "properties": {"status": {"enum": ["AVAILABLE", "NONE_RECORDED"]}, "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/effectItem"}}, "total_count": {"$ref": "#/$defs/count"}, "truncated": {"type": "boolean"}, "counts_by_outcome": {"$ref": "#/$defs/countMap"}}
    },
    "approvalItem": {
      "type": "object", "additionalProperties": false, "required": ["approval_id", "approver_principal_id", "target_type", "effect_id", "decision", "policy_version", "issued_at", "expires_at", "association_basis"],
      "properties": {"approval_id": {"$ref": "#/$defs/ref"}, "approver_principal_id": {"$ref": "#/$defs/nullableRef"}, "target_type": {"$ref": "#/$defs/ref"}, "effect_id": {"$ref": "#/$defs/nullableRef"}, "decision": {"enum": ["APPROVE", "DENY"]}, "policy_version": {"$ref": "#/$defs/ref"}, "issued_at": {"$ref": "#/$defs/timestamp"}, "expires_at": {"$ref": "#/$defs/nullableTimestamp"}, "association_basis": {"const": "TASK_EFFECT_OR_OBJECT_OR_RUN_TARGET"}}
    },
    "approvals": {
      "type": "object", "additionalProperties": false, "required": ["status", "items", "total_count", "truncated", "decision_counts"],
      "properties": {"status": {"enum": ["AVAILABLE", "NONE_RECORDED", "REDACTED"]}, "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/approvalItem"}}, "total_count": {"type": ["integer", "null"], "minimum": 0}, "truncated": {"type": "boolean"}, "decision_counts": {"oneOf": [{"$ref": "#/$defs/countMap"}, {"type": "null"}]}}
    },
    "budgetAvailable": {
      "type": "object", "additionalProperties": false, "required": ["status", "account_id", "limits", "current_counters", "reservations", "actual_spend", "interpretation"],
      "properties": {
        "status": {"const": "AVAILABLE"}, "account_id": {"$ref": "#/$defs/ref"},
        "limits": {"type": "object", "additionalProperties": false, "required": ["amount_limit", "unit", "unit_status", "model_call_limit", "tool_call_limit", "child_run_limit"], "properties": {"amount_limit": {"type": "number", "minimum": 0}, "unit": {"enum": ["tokens", "milliseconds", "bytes", "runs", "records", "candidates", "credits", "microcredits", "calls", "boolean", "USD", "EUR", "GBP", "CNY", "JPY", "OTHER"]}, "unit_status": {"enum": ["KNOWN_SAFE", "REDACTED"]}, "model_call_limit": {"$ref": "#/$defs/count"}, "tool_call_limit": {"$ref": "#/$defs/count"}, "child_run_limit": {"$ref": "#/$defs/count"}}},
        "current_counters": {"type": "object", "additionalProperties": false, "required": ["reserved", "consumed", "model_calls_reserved", "model_calls_consumed", "tool_calls_reserved", "tool_calls_consumed", "child_runs_reserved", "child_runs_consumed"], "properties": {"reserved": {"type": "number", "minimum": 0}, "consumed": {"type": "number", "minimum": 0}, "model_calls_reserved": {"$ref": "#/$defs/count"}, "model_calls_consumed": {"$ref": "#/$defs/count"}, "tool_calls_reserved": {"$ref": "#/$defs/count"}, "tool_calls_consumed": {"$ref": "#/$defs/count"}, "child_runs_reserved": {"$ref": "#/$defs/count"}, "child_runs_consumed": {"$ref": "#/$defs/count"}}},
        "reservations": {"type": "object", "additionalProperties": false, "required": ["items", "total_count", "truncated"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["reservation_id", "run_id", "amount", "model_calls", "tool_calls", "child_runs", "state", "created_at"], "properties": {"reservation_id": {"$ref": "#/$defs/ref"}, "run_id": {"$ref": "#/$defs/ref"}, "amount": {"type": "number", "minimum": 0}, "model_calls": {"$ref": "#/$defs/count"}, "tool_calls": {"$ref": "#/$defs/count"}, "child_runs": {"$ref": "#/$defs/count"}, "state": {"enum": ["RESERVED", "CONSUMED", "RELEASED"]}, "created_at": {"$ref": "#/$defs/timestamp"}}}}, "total_count": {"$ref": "#/$defs/count"}, "truncated": {"type": "boolean"}}},
        "actual_spend": {"const": "UNKNOWN"}, "interpretation": {"const": "BUDGET_RESERVATION_IS_NOT_PROVIDER_SPEND"}
      }
    },
    "budgetUnavailable": {"type": "object", "additionalProperties": false, "required": ["status", "reason", "actual_spend"], "properties": {"status": {"const": "UNAVAILABLE"}, "reason": {"const": "NO_BUDGET_ACCOUNT_RECORDED"}, "actual_spend": {"const": "UNKNOWN"}}},
    "budget": {"oneOf": [{"$ref": "#/$defs/budgetAvailable"}, {"$ref": "#/$defs/budgetUnavailable"}]},
    "metricBasis": {"type": "object", "additionalProperties": false, "required": ["present"], "properties": {"present": {"type": "boolean"}}},
    "safeMetric": {
      "type": "object", "additionalProperties": false, "required": ["value", "value_status", "provenance", "unit", "unit_status", "basis", "estimate_status", "estimation_basis"],
      "properties": {
        "value": {"type": ["number", "boolean", "null"]}, "value_status": {"enum": ["AVAILABLE", "UNAVAILABLE", "REDACTED"]},
        "provenance": {"enum": ["OBSERVED", "HOST_DECLARED", "DERIVED", "UNAVAILABLE"]},
        "unit": {"type": ["string", "null"], "enum": ["tokens", "milliseconds", "bytes", "runs", "records", "candidates", "credits", "microcredits", "calls", "boolean", "USD", "EUR", "GBP", "CNY", "JPY", "OTHER", null]},
        "unit_status": {"enum": ["KNOWN_SAFE", "NOT_RECORDED", "REDACTED"]}, "basis": {"$ref": "#/$defs/metricBasis"},
        "estimate_status": {"enum": ["NOT_ESTIMATED", "ESTIMATED", "UNAVAILABLE"]},
        "estimation_basis": {"$ref": "#/$defs/metricBasis"}
      }
    },
    "meteringItem": {
      "type": "object", "additionalProperties": false, "required": ["record_id", "task_id", "run_id", "record_source", "participation_mode", "context_pack_ref", "metrics_sha256", "recorded_at", "metrics", "unrecognized_metric_count", "sensitive_text_redacted"],
      "properties": {
        "record_id": {"$ref": "#/$defs/ref"}, "task_id": {"$ref": "#/$defs/ref"}, "run_id": {"$ref": "#/$defs/ref"},
        "record_source": {"enum": ["NEXUS_CONTEXT_COMPILER", "HOST_DECLARED", "HOST_OBSERVED"]}, "participation_mode": {"enum": ["ACTIVE", "OBSERVE"]},
        "context_pack_ref": {"$ref": "#/$defs/nullableRef"}, "metrics_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "recorded_at": {"$ref": "#/$defs/timestamp"},
        "metrics": {"type": "object", "propertyNames": {"enum": ["model_visible_input_tokens", "host_total_turn_input_tokens", "cached_input_tokens", "cache_write_input_tokens", "uncached_input_tokens", "output_tokens", "reasoning_tokens", "latency_ms", "context_pack_bytes", "context_pack_token_count", "skill_instruction_tokens", "duplicate_work_reused_count", "duplicate_work_avoided_count", "actual_cost", "estimated_cost", "token_savings", "nexus_influenced_execution"]}, "additionalProperties": {"$ref": "#/$defs/safeMetric"}},
        "unrecognized_metric_count": {"$ref": "#/$defs/count"}, "sensitive_text_redacted": {"type": "boolean"}
      }
    },
    "metering": {
      "type": "object", "additionalProperties": false, "required": ["status", "reason", "total_count", "items", "truncated", "counts_by_source", "metric_interpretation"],
      "properties": {
        "status": {"enum": ["AVAILABLE", "UNAVAILABLE"]}, "reason": {"type": ["string", "null"], "enum": ["NO_METERING_RECORDS", null]},
        "total_count": {"$ref": "#/$defs/count"}, "items": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/meteringItem"}},
        "truncated": {"type": "boolean"}, "counts_by_source": {"type": "object", "additionalProperties": false, "properties": {"NEXUS_CONTEXT_COMPILER": {"$ref": "#/$defs/count"}, "HOST_DECLARED": {"$ref": "#/$defs/count"}, "HOST_OBSERVED": {"$ref": "#/$defs/count"}}},
        "metric_interpretation": {"const": "TYPED_METRICS_PRESERVED_FREE_TEXT_REDACTED"}
      }
    },
    "routingAndCapabilities": {
      "type": "object", "additionalProperties": false, "required": ["run_executor_counts", "requested_capability_counts", "route_decision_count", "grant_action_scopes", "host_native_tool_coverage"],
      "properties": {
        "run_executor_counts": {"type": "object", "additionalProperties": false, "properties": {"ORCHESTRATOR": {"$ref": "#/$defs/count"}, "MODEL": {"$ref": "#/$defs/count"}, "TOOL": {"$ref": "#/$defs/count"}}},
