{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/nexus.run_manifest@1",
  "title": "Nexus RunManifest v1",
  "oneOf": [
    {"$ref": "#/$defs/orchestrator"},
    {"$ref": "#/$defs/model"},
    {"$ref": "#/$defs/tool"}
  ],
  "$defs": {
    "dataBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_classifications", "handling_tags"],
      "properties": {
        "allowed_classifications": {"type": "array", "items": {"enum": ["PUBLIC", "PERSONAL", "PROJECT_PRIVATE", "CONFIDENTIAL", "SECRET"]}, "uniqueItems": true},
        "handling_tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "common": {
      "type": "object",
      "required": ["schema_id", "schema_version", "executor_kind", "runtime_version", "policy_version", "schema_versions", "input_object_refs", "authority_grant_ref", "data_boundary", "classification_assertion_ref"],
      "properties": {
        "schema_id": {"const": "nexus.run_manifest"},
        "schema_version": {"const": 1},
        "executor_kind": {"enum": ["ORCHESTRATOR", "MODEL", "TOOL"]},
        "runtime_version": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "schema_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
        "input_object_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "authority_grant_ref": {"type": "string", "minLength": 1},
        "budget_reservation_ref": {"type": "string", "minLength": 1},
        "data_boundary": {"$ref": "#/$defs/dataBoundary"},
        "classification_assertion_ref": {"type": "string", "minLength": 1}
      }
    },
    "orchestrator": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {"type": "object", "properties": {"executor_kind": {"const": "ORCHESTRATOR"}, "task_contract_ref": {"type": "string", "minLength": 1}, "dag_version": {"type": "string", "minLength": 1}, "scheduler_version": {"type": "string", "minLength": 1}}, "required": ["task_contract_ref", "dag_version", "scheduler_version"]}
      ],
      "unevaluatedProperties": false
    },
    "model": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {"type": "object", "properties": {"executor_kind": {"const": "MODEL"}, "model_id": {"type": "string", "minLength": 1}, "provider": {"type": "string", "minLength": 1}, "model_class": {"enum": ["E0", "E1", "E2", "specialist", "local_private"]}, "model_adapter_version": {"type": "string", "minLength": 1}, "prompt_version": {"type": "string", "minLength": 1}, "context_object_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "route_decision_ref": {"type": "string", "minLength": 1}}, "required": ["model_id", "provider", "model_class", "model_adapter_version", "prompt_version", "context_object_refs", "route_decision_ref"]}
      ],
      "unevaluatedProperties": false
    },
    "tool": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {"type": "object", "properties": {"executor_kind": {"const": "TOOL"}, "tool_id": {"type": "string", "minLength": 1}, "tool_descriptor_version": {"type": "string", "minLength": 1}, "tool_adapter_version": {"type": "string", "minLength": 1}, "input_ref": {"type": "string", "minLength": 1}, "effect_ref": {"type": "string", "minLength": 1}}, "required": ["tool_id", "tool_descriptor_version", "tool_adapter_version", "input_ref"]}
      ],
      "unevaluatedProperties": false
    }
  }
}
