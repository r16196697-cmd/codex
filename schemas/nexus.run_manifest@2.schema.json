{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/nexus.run_manifest@2",
  "title": "Nexus attached-host MODEL RunManifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "executor_kind", "runtime_version", "policy_version", "schema_versions", "input_object_refs", "authority_grant_ref", "budget_reservation_ref", "data_boundary", "classification_assertion_ref", "execution_source", "host_kind", "host_adapter_version", "model_identity_status", "context_object_refs"],
  "properties": {
    "schema_id": {"const": "nexus.run_manifest"},
    "schema_version": {"const": 2},
    "executor_kind": {"const": "MODEL"},
    "runtime_version": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "schema_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
    "input_object_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "authority_grant_ref": {"type": "string", "minLength": 1},
    "budget_reservation_ref": {"type": "string", "minLength": 1},
    "data_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_classifications", "handling_tags"],
      "properties": {
        "allowed_classifications": {"type": "array", "items": {"enum": ["PUBLIC", "PERSONAL", "PROJECT_PRIVATE", "CONFIDENTIAL", "SECRET"]}, "uniqueItems": true},
        "handling_tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "classification_assertion_ref": {"type": "string", "minLength": 1},
    "execution_source": {"const": "CODEX_HOST_DECLARED"},
    "host_kind": {"const": "CODEX"},
    "host_adapter_version": {"type": "string", "minLength": 1},
    "model_identity_status": {"const": "UNAVAILABLE"},
    "context_object_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
