{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/nexus.purge_plan@2",
  "title": "Nexus PurgePlan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "plan_id", "task_id", "target_refs", "descendant_refs", "affected_indexes", "planned_actions", "lineage_revision", "plan_hash", "created_at", "policy_version"],
  "properties": {
    "schema_id": {"const": "nexus.purge_plan"},
    "schema_version": {"const": 2},
    "plan_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "target_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "descendant_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "affected_indexes": {"type": "array", "items": {"enum": ["raw_history", "admitted_memory"]}, "uniqueItems": true},
    "planned_actions": {"type": "array", "items": {"enum": ["QUIESCE_RUNS", "RECONCILE_EFFECTS", "DELETE_PAYLOADS", "DELETE_INDEX_ROWS", "REDACT_DERIVED_METADATA", "VERIFY_UNAVAILABLE"]}, "uniqueItems": true},
    "lineage_revision": {"type": "integer", "minimum": 0},
    "plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "policy_version": {"type": "string", "minLength": 1}
  }
}
