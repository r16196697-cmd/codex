{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/nexus.route_decision@2",
  "title": "Nexus RouteDecision v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "route_decision_id", "subtask_id", "attempt_no", "requested_capability", "actual_executor_kind", "execution_source", "model_identity_status", "reason_codes", "created_at"],
  "properties": {
    "schema_id": {"const": "nexus.route_decision"},
    "schema_version": {"const": 2},
    "route_decision_id": {"type": "string", "minLength": 1},
    "subtask_id": {"type": "string", "minLength": 1},
    "attempt_no": {"type": "integer", "minimum": 1},
    "requested_capability": {"enum": ["TOOL", "E0", "E1", "E2", "UNSPECIFIED"]},
    "routing_constraints": {"type": "object"},
    "actual_executor_kind": {"enum": ["MODEL", "TOOL"]},
    "execution_source": {"enum": ["CODEX_HOST_DECLARED", "CODEX_HOST_TOOL_DECLARED", "DETERMINISTIC_RUNTIME"]},
    "model_identity_status": {"enum": ["OBSERVED", "UNAVAILABLE", "NOT_APPLICABLE"]},
    "actual_model_id": {"type": "string", "minLength": 1},
    "actual_model_profile_ref": {"type": "string", "minLength": 1},
    "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"execution_source": {"const": "CODEX_HOST_DECLARED"}}, "required": ["execution_source"]}, "then": {"properties": {"actual_executor_kind": {"const": "MODEL"}, "model_identity_status": {"const": "UNAVAILABLE"}}, "not": {"anyOf": [{"required": ["actual_model_id"]}, {"required": ["actual_model_profile_ref"]}]}}},
    {"if": {"properties": {"execution_source": {"const": "CODEX_HOST_TOOL_DECLARED"}}, "required": ["execution_source"]}, "then": {"properties": {"actual_executor_kind": {"const": "TOOL"}, "model_identity_status": {"const": "NOT_APPLICABLE"}}}},
    {"if": {"properties": {"actual_executor_kind": {"const": "TOOL"}}, "required": ["actual_executor_kind"]}, "then": {"properties": {"model_identity_status": {"const": "NOT_APPLICABLE"}}}}
  ]
}
