{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/nexus.route_decision@1",
  "title": "Nexus RouteDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "route_decision_id", "run_or_subtask_id", "route_policy_version", "task_class", "risk_class", "quality_requirement", "user_policy_ref", "eligible_models", "excluded_models", "exclusion_reasons", "selected_model_class", "selected_model_id", "selected_model_profile_version", "reason_codes", "budget_snapshot", "escalation_allowed", "created_at"],
  "properties": {
    "schema_id": {"const": "nexus.route_decision"},
    "schema_version": {"const": 1},
    "route_decision_id": {"type": "string", "minLength": 1},
    "run_or_subtask_id": {"type": "string", "minLength": 1},
    "route_policy_version": {"type": "string", "minLength": 1},
    "task_class": {"type": "string", "minLength": 1},
    "risk_class": {"enum": ["LOW", "STANDARD", "HIGH", "CRITICAL"]},
    "quality_requirement": {"enum": ["ROUTINE", "STANDARD", "CRITICAL"]},
    "user_policy_ref": {"type": "string", "minLength": 1},
    "eligible_models": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["model_id", "model_class", "provider", "version"], "properties": {"model_id": {"type": "string"}, "model_class": {"type": "string"}, "provider": {"type": "string"}, "version": {"type": "string"}}}},
    "excluded_models": {"type": "array", "items": {"type": "string"}},
    "exclusion_reasons": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["model_id", "reason_code"], "properties": {"model_id": {"type": "string"}, "reason_code": {"type": "string"}}}},
    "selected_model_class": {"enum": ["E0", "E1", "E2", "specialist", "local_private"]},
    "selected_model_id": {"type": "string", "minLength": 1},
    "selected_model_profile_version": {"type": "string", "minLength": 1},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "budget_snapshot": {"type": "object", "additionalProperties": false, "required": ["account_id", "unit", "limit", "reserved", "consumed", "remaining", "model_calls_remaining", "tool_calls_remaining", "child_runs_remaining"], "properties": {"account_id": {"type": "string"}, "unit": {"type": "string"}, "limit": {"type": "integer"}, "reserved": {"type": "integer"}, "consumed": {"type": "integer"}, "remaining": {"type": "integer"}, "model_calls_remaining": {"type": "integer"}, "tool_calls_remaining": {"type": "integer"}, "child_runs_remaining": {"type": "integer"}}},
    "escalation_allowed": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
